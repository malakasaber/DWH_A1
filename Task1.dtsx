          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[using System;
using System.Collections.Generic;
using System.IO;

public class Program
{
    private static void Main(string[] args)
    {
        // Sample JSON data as a string (can be replaced with your local JSON data)
        string json = File.ReadAllText("data.json"); // If you have a JSON file, specify its path

        if (!string.IsNullOrEmpty(json))
        {
            try
            {
                // Try to extract a list of usernames
                List<string> usernames = ExtractJsonField(json, "\"username\":");
                Console.WriteLine("Usernames:");
                foreach (string username in usernames)
                {
                    Console.WriteLine(username);
                }

                // Example of extracting a nested field (address.street)
                List<string> streets = ExtractJsonField(json, "\"address\":{\"street\":\"");
                Console.WriteLine("\nStreets:");
                foreach (string street in streets)
                {
                    Console.WriteLine(street);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("An error occurred while processing the JSON data: " + ex.Message);
            }
        }
        else
        {
            Console.WriteLine("Failed to retrieve or parse the JSON data.");
        }
    }

    // Extract specific fields from JSON string
    private static List<string> ExtractJsonField(string json, string fieldName)
    {
        List<string> values = new List<string>();
        int startIndex = 0;

        while ((startIndex = json.IndexOf(fieldName, startIndex)) != -1)
        {
            try
            {
                // Find the starting position of the value (right after the colon and space)
                int valueStartIndex = json.IndexOf(":", startIndex) + 2; // Skip ": "
                int valueEndIndex = json.IndexOf("\"", valueStartIndex);

                if (valueStartIndex == -1 || valueEndIndex == -1)
                {
                    throw new Exception("Error parsing value for field: " + fieldName);
                }

                string value = json.Substring(valueStartIndex, valueEndIndex - valueStartIndex).Trim();
                values.Add(value);

                // Move startIndex forward to continue looking for more occurrences
                startIndex = valueEndIndex;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error processing field '{fieldName}': {ex.Message}");
                break; // Exit loop on error
            }
        }

        return values;
    }
}]]></ProjectItem>

              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[Attendance_Device]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CheckIns AS (
    SELECT 
        Employee_Id,
        CAST(Finger_Print_TS AS DATE) AS [Date],
        MIN(CAST(Finger_Print_TS AS TIME)) AS Time_In,
        MAX(CAST(Finger_Print_TS AS TIME)) AS Last_In
    FROM Attendance_Device
    WHERE In_Out = 'in'
    GROUP BY Employee_Id, CAST(Finger_Print_TS AS DATE)
),
CheckOuts AS (
    SELECT 
        Employee_Id,
        CAST(Finger_Print_TS AS DATE) AS [Date],
        MIN(CAST(Finger_Print_TS AS TIME)) AS Time_Out
    FROM Attendance_Device ad
    WHERE In_Out = 'out'
        AND EXISTS (
            SELECT 1
            FROM Attendance_Device aid
            WHERE aid.Employee_Id = ad.Employee_Id
            AND aid.In_Out = 'in'
            AND CAST(aid.Finger_Print_TS AS DATE) = CAST(ad.Finger_Print_TS AS DATE)
            AND CAST(ad.Finger_Print_TS AS TIME) &gt;= (
                SELECT MAX(CAST(Finger_Print_TS AS TIME))
                FROM Attendance_Device
                WHERE Employee_Id = ad.Employee_Id
                AND In_Out = 'in'
                AND CAST(Finger_Print_TS AS DATE) = CAST(ad.Finger_Print_TS AS DATE)
            )
        )
    GROUP BY Employee_Id, CAST(Finger_Print_TS AS DATE)
)

SELECT
    ci.Employee_Id,
    ci.[Date],
    ci.Time_In,
    co.Time_Out,
    DATEDIFF(HOUR, ci.Time_In, co.Time_Out) AS Worked_Hours
FROM CheckIns ci
LEFT JOIN CheckOuts co
    ON ci.Employee_Id = co.Employee_Id AND ci.[Date] = co.[Date];</property>

          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.IO;
using System.Net;
using System.Collections.Generic;
using System.Web.Script.Serialization;
using System.Text;
#endregion

namespace ST_ca586e987d404926a6c576910266c30e
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            string url = "https://jsonplaceholder.typicode.com/users";
            string json = "";

            try
            {
                using (WebClient client = new WebClient())
                {
                    json = client.DownloadString(url);
                }

                var serializer = new JavaScriptSerializer();
                var users = serializer.Deserialize<List<User>>(json);

                string filePath = @"C:\Users\Malak\DWH_A1_Files\Users.csv";

                string directory = Path.GetDirectoryName(filePath);
                if (!Directory.Exists(directory))
                {
                    Directory.CreateDirectory(directory);
                }

                using (StreamWriter writer = new StreamWriter(filePath, false, new UTF8Encoding(false)))
                {
                    writer.WriteLine("name,username,email,website");

                    foreach (var user in users)
                    {
                        writer.WriteLine($"\"{user.name}\",\"{user.username}\",\"{user.email}\",\"{user.website}\"");
                    }
                }

                Console.WriteLine("✅ Users.csv created cleanly.");
            }
            catch (Exception ex)
            {
                Console.WriteLine("❌ Error: " + ex.Message);
            }

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        // Class matching the JSON structure
        public class User
        {
            public string name { get; set; }
            public string username { get; set; }
            public string email { get; set; }
            public string website { get; set; }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
